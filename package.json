{
  "name": "dsh-monkeyai-sessions",
  "version": "0.1.0",
  "description": "DeepSeek Harness panel for authorized MonkeyAI remote sessions",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./remote": "./src/remote.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "lib/client-runtime.cjs",
    "src/**/*.js",
    "src/**/*.mjs",
    "scripts/build-client.mjs",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "react": "18.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "react",
        "zod"
      ]
    }
  }
}
