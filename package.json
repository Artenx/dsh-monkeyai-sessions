{
  "name": "dsh-monkeyai-sessions",
  "version": "0.1.0",
  "description": "Read and continue your MonkeyAI conversations inside DeepSeek Harness: browse session history and send new instructions to pick up exactly where you left off in the MonkeyAI client",
  "type": "module",
  "license": "MIT",
  "author": "Artenx",
  "homepage": "https://github.com/Artenx/dsh-monkeyai-sessions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artenx/dsh-monkeyai-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/Artenx/dsh-monkeyai-sessions/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "monkeyai",
    "remote-sessions",
    "acp"
  ],
  "icon": "./assets/icon.svg",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./remote": "./src/remote.js",
    "./icon": "./assets/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/icon.svg",
    "client.js",
    "cordis.patch.yml",
    "lib/client-runtime.cjs",
    "src/**/*.js",
    "src/**/*.mjs",
    "scripts/build-client.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:market": "node scripts/build-market-index.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "react",
        "zod"
      ]
    }
  }
}
